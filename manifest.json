{
  "manifest_version": 3,
  "name": "DeKindled (Images)",
  "version": "2.0.0",
  "description": "Capture Kindle Cloud Reader pages and download them as a ZIP of images (no OpenAI, no EPUB)",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png",
    "1024": "icon.png"
  },
  "permissions": [
    "scripting",
    "activeTab",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://read.amazon.com/*",
    "https://read.amazon.co.uk/*",
    "https://read.amazon.co.jp/*",
    "https://read.amazon.de/*",
    "https://read.amazon.fr/*",
    "https://read.amazon.es/*",
    "https://read.amazon.it/*",
    "https://read.amazon.nl/*",
    "https://read.amazon.ca/*",
    "https://read.amazon.com.au/*",
    "https://read.amazon.com.br/*",
    "https://read.amazon.com.mx/*",
    "https://read.amazon.in/*",
    "https://read.amazon.pl/*",
    "https://read.amazon.se/*",
    "https://read.amazon.com.tr/*",
    "https://read.amazon.com.be/*",
    "https://read.amazon.sg/*",
    "https://read.amazon.ae/*",
    "https://read.amazon.sa/*",
    "https://read.amazon.eg/*",
    "https://lire.amazon.fr/*",
    "https://lesen.amazon.de/*",
    "https://leggi.amazon.it/*",
    "https://leer.amazon.es/*",
    "https://lezen.amazon.nl/*",
    "https://ler.amazon.com.br/*",
    "https://leer.amazon.com.mx/*",
    "https://czytaj.amazon.pl/*",
    "https://oku.amazon.com.tr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DeKindled - Click to manage captured content",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://read.amazon.com/*",
        "https://read.amazon.co.uk/*",
        "https://read.amazon.co.jp/*",
        "https://read.amazon.de/*",
        "https://read.amazon.fr/*",
        "https://read.amazon.es/*",
        "https://read.amazon.it/*",
        "https://read.amazon.nl/*",
        "https://read.amazon.ca/*",
        "https://read.amazon.com.au/*",
        "https://read.amazon.com.br/*",
        "https://read.amazon.com.mx/*",
        "https://read.amazon.in/*",
        "https://read.amazon.pl/*",
        "https://read.amazon.se/*",
        "https://read.amazon.com.tr/*",
        "https://read.amazon.com.be/*",
        "https://read.amazon.sg/*",
        "https://read.amazon.ae/*",
        "https://read.amazon.sa/*",
        "https://read.amazon.eg/*",
        "https://lire.amazon.fr/*",
        "https://lesen.amazon.de/*",
        "https://leggi.amazon.it/*",
        "https://leer.amazon.es/*",
        "https://lezen.amazon.nl/*",
        "https://ler.amazon.com.br/*",
        "https://leer.amazon.com.mx/*",
        "https://czytaj.amazon.pl/*",
        "https://oku.amazon.com.tr/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["interceptor.js", "viewer-inject.js", "zip-utils.js"],
      "matches": [
        "https://read.amazon.com/*",
        "https://read.amazon.co.uk/*",
        "https://read.amazon.co.jp/*",
        "https://read.amazon.de/*",
        "https://read.amazon.fr/*",
        "https://read.amazon.es/*",
        "https://read.amazon.it/*",
        "https://read.amazon.nl/*",
        "https://read.amazon.ca/*",
        "https://read.amazon.com.au/*",
        "https://read.amazon.com.br/*",
        "https://read.amazon.com.mx/*",
        "https://read.amazon.in/*",
        "https://read.amazon.pl/*",
        "https://read.amazon.se/*",
        "https://read.amazon.com.tr/*",
        "https://read.amazon.com.be/*",
        "https://read.amazon.sg/*",
        "https://read.amazon.ae/*",
        "https://read.amazon.sa/*",
        "https://read.amazon.eg/*",
        "https://lire.amazon.fr/*",
        "https://lesen.amazon.de/*",
        "https://leggi.amazon.it/*",
        "https://leer.amazon.es/*",
        "https://lezen.amazon.nl/*",
        "https://ler.amazon.com.br/*",
        "https://leer.amazon.com.mx/*",
        "https://czytaj.amazon.pl/*",
        "https://oku.amazon.com.tr/*"
      ]
    }
  ]
}
